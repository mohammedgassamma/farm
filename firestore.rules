rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users: chaque utilisateur accède uniquement à son propre document
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isAdmin();
    }

    // Crops: accessible uniquement par son propriétaire ou un admin
    match /crops/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Livestock: accessible uniquement par son propriétaire ou un admin
    match /livestock/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Store/Products: lecture pour tous les connectés, écriture admin uniquement
    match /store/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Orders: lecture/écriture par propriétaire ou admin
    match /orders/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Subscriptions: lecture par propriétaire, écriture admin
    match /subscriptions/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Subscription configs: lecture seule pour tous
    match /subscriptionConfigs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Education: lecture pour tous, écriture admin
    match /education/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Alerts: lecture par propriétaire ou admin
    match /alerts/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
